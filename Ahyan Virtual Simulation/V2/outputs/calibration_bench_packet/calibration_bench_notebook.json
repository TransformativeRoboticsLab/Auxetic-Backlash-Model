{
  "schema": "rad-sim.calibration-bench-notebook.v1",
  "grid": {
    "rows": 3,
    "cols": 3,
    "cellSize": 1.0,
    "backlash": 0.1,
    "couplingGain": 0.55,
    "zCouplingGain": 0.32,
    "pinRadius": 0.18,
    "holeRadius": 0.225,
    "pinHoleClearance": 0.04500000000000001
  },
  "protocol": {
    "schema": "rad-sim.calibration-experiment-protocol.v1",
    "hardwareProfile": "paper-reference",
    "centerCell": {
      "row": 1,
      "col": 1
    },
    "stepCount": 7,
    "repeatCountTotal": 21,
    "notes": "Protocol defines repeatable simulator/bench measurements; it does not claim the current spring-hinge solver is calibrated."
  },
  "datasetPlan": {
    "fit": {
      "datasetId": "fit-run-001",
      "role": "fit",
      "suggestedFilename": "fit-run-001.json",
      "sourceFileId": "fit-run-001.json",
      "profileId": null,
      "profileFrozenAt": null,
      "provenanceSchema": "rad-sim.calibration-dataset-provenance.v1",
      "purpose": "Estimate diagnostic response parameters and freeze a bounded model profile."
    },
    "holdout": {
      "datasetId": "holdout-run-001",
      "role": "holdout",
      "suggestedFilename": "holdout-run-001.json",
      "sourceFileId": "holdout-run-001.json",
      "profileId": "calibration-profile-v1",
      "profileFrozenAt": "set-after-fit-before-holdout",
      "provenanceSchema": "rad-sim.calibration-dataset-provenance.v1",
      "purpose": "Replay the frozen profile against data collected after the fit file is closed."
    }
  },
  "instruments": [
    {
      "id": "calipers-or-micrometer",
      "measures": [
        "pin radius",
        "hole radius",
        "plate thickness",
        "joint stack height"
      ],
      "claimLabel": "required geometry measurement"
    },
    {
      "id": "motion-tracking-camera",
      "measures": [
        "cell center displacement",
        "height delta",
        "neighbor residual z"
      ],
      "claimLabel": "required response measurement"
    },
    {
      "id": "force-gauge-or-load-cell",
      "measures": [
        "actuator force",
        "contact/load proxy"
      ],
      "claimLabel": "required force measurement for contact calibration"
    },
    {
      "id": "fixture-and-clamps",
      "measures": [
        "locked cell enforcement",
        "fixed boundary repeatability"
      ],
      "claimLabel": "required boundary-condition control"
    },
    {
      "id": "actuator-controller",
      "measures": [
        "commanded alpha",
        "commanded z",
        "command repeat timing"
      ],
      "claimLabel": "required command provenance"
    },
    {
      "id": "scale-reference-marker",
      "measures": [
        "pixel-to-mm scale",
        "coordinate registration"
      ],
      "claimLabel": "required unit-scale evidence"
    }
  ],
  "measurementColumns": [
    "datasetId",
    "datasetRole",
    "sourceFileId",
    "collectedAt",
    "operator",
    "profileId",
    "profileFrozenAt",
    "alpha_delta_grid",
    "height_delta_grid",
    "center_displacement_grid",
    "actuator_command",
    "lock_state",
    "pin_hole_slip_mm",
    "actuator_force_n"
  ],
  "phases": [
    {
      "id": "setup",
      "description": "Measure hardware profile fields and register the cell coordinate frame.",
      "requiredEvidence": [
        "hardware profile",
        "scale marker",
        "fixture notes"
      ]
    },
    {
      "id": "fit-collection",
      "description": "Collect the fit dataset without using any holdout measurements.",
      "requiredEvidence": [
        "fit-run-001",
        "datasetRole=fit"
      ]
    },
    {
      "id": "profile-freeze",
      "description": "Generate and freeze a model profile before holdout collection starts.",
      "requiredEvidence": [
        "calibration-profile-v1",
        "set-after-fit-before-holdout"
      ]
    },
    {
      "id": "holdout-collection",
      "description": "Collect a separate holdout file after the model profile is frozen.",
      "requiredEvidence": [
        "holdout-run-001",
        "datasetRole=holdout"
      ]
    },
    {
      "id": "validation",
      "description": "Run residual validation and independent split checks before making physical claims.",
      "requiredEvidence": [
        "rad-sim.calibration-model-profile-holdout-validation.v1",
        "rad-sim.calibration-train-holdout-split.v1"
      ]
    }
  ],
